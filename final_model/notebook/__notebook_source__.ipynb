import xarray as xr
import numpy as np

# ============================================================
# SIH26078 - CLIMATOLOGY MATCHING
# ============================================================

def get_climatology_for_times(clim_ds, times):
    """
    Match each datetime to:
      - day of year
      - hour (0, 6, 12, 18)

    Returns climatology data aligned with the supplied times.
    """

    # Convert xarray/cftime-like timestamps to numpy datetime64
    times = np.asarray(times)

    # Extract day-of-year and hour
    time_index = xr.DataArray(
        times,
        dims="sample_time",
        name="sample_time"
    )

    day_of_year = time_index.dt.dayofyear
    hour = time_index.dt.hour

    # Handle leap-day safely by mapping Feb 29 to Feb 28
    day_of_year = xr.where(
        day_of_year == 60,
        59,
        day_of_year
    )

    # Match against climatology
    clim_selected = clim_ds.sel(
        dayofyear=day_of_year,
        hour=hour
    )

    return clim_selected


# Take the first forecast initialization
