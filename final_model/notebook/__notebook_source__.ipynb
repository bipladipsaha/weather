# ------------------------------------------------
# 3. Build distributed contiguous training blocks
# ------------------------------------------------
#
# Why?
#
# A random list such as:
#   [3, 718, 1500, 2991, ...]
#
# causes scattered remote reads.
#
# Instead, we create 32 contiguous blocks spread across
# the entire 2016-2020 period.
#
# Total:
#   16 blocks × 63 samples
# + 16 blocks × 62 samples
# = 2000 samples
#
# This keeps each remote request contiguous while maintaining
# temporal coverage across the complete training period.
# ------------------------------------------------

def make_distributed_blocks(
    positions,
    target_samples,
    n_blocks=32
):
    if target_samples > len(positions):
        raise ValueError(
            "target_samples exceeds available positions."
        )

    if target_samples < n_blocks:
        raise ValueError(
            "target_samples must be >= n_blocks."
        )

    base_length = target_samples // n_blocks
    remainder = target_samples % n_blocks

    blocks = []

    for block_id in range(n_blocks):

        block_length = (
            base_length + 1
            if block_id < remainder
            else base_length
        )

        # Temporal bin occupied by this block.
        bin_start = int(
            np.floor(
                block_id * len(positions) / n_blocks
            )
        )

        bin_end = int(
            np.floor(
                (block_id + 1) * len(positions) / n_blocks
            )
        )

        available_length = bin_end - bin_start

        if available_length < block_length:
            # Fallback: place block at the end of its bin
            local_start = max(
                0,
                bin_end - block_length
            )
        else:
            # Center the selected block inside the bin
            local_start = (
                bin_start
                + (available_length - block_length) // 2
            )

        local_end = local_start + block_length

        selected_positions = positions[
            local_start:local_end
        ]

        blocks.append(
            {
                "id": block_id,
                "positions": selected_positions,
                "count": len(selected_positions),
                "start_position": int(selected_positions[0]),
                "end_position": int(selected_positions[-1]),
                "start_time": str(
                    all_times[selected_positions[0]]
                ),
                "end_time": str(
                    all_times[selected_positions[-1]]
                ),
            }
        )

    # Verify exact count
    total = sum(
        block["count"]
        for block in blocks
    )

    if total != target_samples:
        raise RuntimeError(
            f"Training block construction failed: "
            f"expected {target_samples}, got {total}."
        )

    return blocks


train_blocks = make_distributed_blocks(
    train_positions,
    TARGET_TRAIN_SAMPLES,
    n_blocks=32
)


# Validation/test are naturally contiguous, so create ordinary
# fixed-size blocks.
def make_contiguous_blocks(
    positions,
    block_size
):
    blocks = []

    block_id = 0

    for start in range(
        0,
        len(positions),
        block_size
    ):
        stop = min(
            start + block_size,
            len(positions)
        )

        selected_positions = positions[start:stop]

        blocks.append(
            {
                "id": block_id,
                "positions": selected_positions,
                "count": len(selected_positions),
                "start_position": int(selected_positions[0]),
                "end_position": int(selected_positions[-1]),
                "start_time": str(
                    all_times[selected_positions[0]]
                ),
                "end_time": str(
                    all_times[selected_positions[-1]]
                ),
            }
        )

        block_id += 1

    return blocks


