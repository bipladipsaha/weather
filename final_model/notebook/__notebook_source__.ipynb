):

    print(
        f"{name.capitalize():10s}: "
        f"F1={score:.4f}"
    )

mean_test_f1 = float(
    test_f1.mean()
)

print(
    f"\nMean test F1: "
    f"{mean_test_f1:.4f}"
)


# ================================================================
# 18. SAVE TEST METRICS
# ================================================================

test_metrics = {

    "test_loss":
        float(test_loss),

    "heat_f1":
        float(test_f1[0]),

    "cold_f1":
        float(test_f1[1]),

    "rain_f1":
        float(test_f1[2]),

    "cyclone_f1":
        float(test_f1[3]),

    "mean_f1":
        mean_test_f1,

    "best_epoch":
        int(checkpoint["epoch"]),

    "best_validation_f1":
        float(
            checkpoint[
                "best_val_f1"
            ]
        ),

    "batch_size":
        int(selected_batch_size),

    "parameters":
        int(parameter_count)
}

test_metrics_path = os.path.join(
    MODEL_ROOT,
    "test_metrics.json"
)

with open(
    test_metrics_path,
    "w"
) as f:

    json.dump(
        test_metrics,
        f,
        indent=2
    )


