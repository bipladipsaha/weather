# ------------------------------------------------
# 8. Save a single dataset block
# ------------------------------------------------

def save_dataset_block(
    dataset,
    output_path
):

    # Temporary path used for atomic save.
    # We NEVER directly overwrite the final file.
    temporary_path = (
        output_path + ".tmp.npz"
    )

    if os.path.exists(temporary_path):
        os.remove(temporary_path)

    arrays = {}

    # Save all model variables as float32.
    # Keep raw scientific data at original precision.
    for variable in dataset.data_vars:

        arrays[variable] = np.asarray(
            dataset[variable].values,
            dtype=np.float32
        )

    # Save initialization times.
    arrays["time"] = np.asarray(
        dataset.time.values
    )

    np.savez_compressed(
        temporary_path,
        **arrays
    )

    # Atomic rename.
    os.replace(
        temporary_path,
        output_path
    )


# ------------------------------------------------
# 9. Process one split
# ------------------------------------------------

def build_split(
    split_name,
    blocks
):

    output_directory = os.path.join(
        CACHE_ROOT,
        split_name
    )

    os.makedirs(
        output_directory,
        exist_ok=True
    )

    total_blocks = len(blocks)

    print("\n" + "=" * 80)
    print(
        f"BUILDING {split_name.upper()} CACHE"
    )
    print("=" * 80)

    completed = 0

    for block in blocks:

        block_id = block["id"]

        output_path = block_filename(
            split_name,
            block_id
        )

        # --------------------------------------------
        # Skip valid existing block
        # --------------------------------------------
        if (
            block_id in progress[split_name]
            and verify_cache_file(output_path)
        ):

            completed += 1

            print(
                f"[SKIP] {split_name}_{block_id:04d}.npz "
                f"| {completed}/{total_blocks}"
            )

            continue

        # --------------------------------------------
        # Remote extraction
        # --------------------------------------------

        positions = block["positions"]

        first_position = int(
            positions[0]
        )

        last_position = int(
            positions[-1]
        )

        # Because all selected blocks are contiguous,
        # use a slice rather than scattered indexing.
        time_slice = slice(
            first_position,
            last_position + 1
        )

        print("\n" + "-" * 80)
        print(
            f"[{split_name.upper()}] "
            f"Block {block_id:04d} "
            f"({completed + 1}/{total_blocks})"
        )

        print(
            f"Samples : {block['count']}"
        )

        print(
            f"Time    : "
            f"{block['start_time']} → "
            f"{block['end_time']}"
        )

        print(
            f"Positions: "
            f"{first_position} → "
            f"{last_position}"
        )

        start_time = time.time()

        try:

            # ----------------------------------------
            # Read from WeatherBench2
            # ----------------------------------------

            with dask.config.set(
                scheduler="threads",
                num_workers=DASK_WORKERS
            ):

                block_dataset = (
                    forecast_base
                    .isel(time=time_slice)
                    .load()
                )

            remote_elapsed = (
                time.time() - start_time
            )

            print(
                f"Remote load complete: "
                f"{remote_elapsed:.1f} sec"
            )

            # ----------------------------------------
            # Make sure requested number of samples
            # was actually returned.
            # ----------------------------------------

            actual_count = int(
                block_dataset.sizes["time"]
            )

            if actual_count != block["count"]:

                raise RuntimeError(
                    f"Expected {block['count']} "
                    f"samples, received {actual_count}."
                )

            # ----------------------------------------
            # Save locally
            # ----------------------------------------

            save_start = time.time()

            save_dataset_block(
                block_dataset,
                output_path
            )

            save_elapsed = (
                time.time() - save_start
            )

            # ----------------------------------------
            # Verify saved file
            # ----------------------------------------

            if not verify_cache_file(
                output_path
            ):

                raise RuntimeError(
                    "Saved cache file failed verification."
                )

            file_size_mb = (
                os.path.getsize(
                    output_path
                )
                / (1024 ** 2)
            )

            total_elapsed = (
                time.time() - start_time
            )

            print(
                f"Local save complete: "
                f"{save_elapsed:.1f} sec"
            )

            print(
                f"File size: "
                f"{file_size_mb:.2f} MB"
            )

            print(
                f"Total block time: "
                f"{total_elapsed:.1f} sec"
            )

            # ----------------------------------------
            # Mark complete
            # ----------------------------------------

            update_progress(
                split_name,
                block_id
            )

            completed += 1

            print(
                f"✅ BLOCK COMPLETE "
                f"({completed}/{total_blocks})"
            )

            # Release RAM
            del block_dataset
            gc.collect()

        except Exception as error:

            print("\n" + "!" * 80)
            print(
                f"❌ ERROR IN "
                f"{split_name}_{block_id:04d}.npz"
            )
            print("!" * 80)

            print(
                f"\nError type: "
                f"{type(error).__name__}"
            )

            print(
                f"Error: {error}"
            )

            print(
                "\nCompleted blocks have NOT been lost."
            )

            print(
                "Rerunning this cell will skip valid "
                "completed blocks."
            )

            traceback.print_exc()

            raise


# ------------------------------------------------
