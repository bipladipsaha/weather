# SIH26078 - NaN / INF DIAGNOSTIC
# ============================================================

import os
import numpy as np

CACHE_ROOT = "/kaggle/working/sih26078_cache"
TRAIN_FILE = f"{CACHE_ROOT}/train/train_0000.npz"

print("=" * 80)
print("SIH26078 NAN / INF DIAGNOSTIC")
print("=" * 80)

with np.load(TRAIN_FILE, allow_pickle=False) as data:

    print("\nVariable quality report:\n")

    bad_variables = []

    for name in data.files:

        arr = data[name]

        # Skip datetime array
        if not np.issubdtype(arr.dtype, np.number):
            print(
                f"{name:28s} "
                f"dtype={arr.dtype} "
                f"shape={arr.shape}"
            )
            continue

        nan_count = int(np.isnan(arr).sum())
        inf_count = int(np.isinf(arr).sum())

        finite_count = np.isfinite(arr).sum()
        total_count = arr.size

        finite_percent = (
            100.0 * finite_count / total_count
            if total_count > 0
            else 0.0
        )

        if finite_count > 0:

            finite_values = arr[np.isfinite(arr)]

            min_value = float(finite_values.min())
            max_value = float(finite_values.max())

        else:

            min_value = np.nan
            max_value = np.nan

        status = "✅"

        if nan_count > 0 or inf_count > 0:
            status = "❌"
            bad_variables.append(name)

        print(
            f"{status} {name:28s} "
            f"shape={str(arr.shape):30s} "
            f"NaN={nan_count:8d} "
            f"Inf={inf_count:8d} "
            f"finite={finite_percent:6.2f}% "
            f"min={min_value:.6g} "
            f"max={max_value:.6g}"
        )

    print("\n" + "-" * 80)

    if bad_variables:

        print("❌ BAD VARIABLES FOUND:")
        for name in bad_variables:
            print(f"   • {name}")

        print("\nDetailed NaN locations:")

        for name in bad_variables:

            arr = data[name]

            nan_mask = np.isnan(arr)
            inf_mask = np.isinf(arr)

            bad_mask = nan_mask | inf_mask

            bad_positions = np.argwhere(bad_mask)

            print(
                f"\n{name}:"
            )

            print(
                f"  Total bad values: "
                f"{len(bad_positions)}"
            )

            # Show first few locations only
            for position in bad_positions[:10]:

                print(
                    f"  position={tuple(position)} "
                    f"value={arr[tuple(position)]}"
                )

            if len(bad_positions) > 10:
                print(
                    f"  ... plus "
                    f"{len(bad_positions) - 10} more"
                )

    else:

        print(
            "✅ No NaN or Inf values found "
            "in this cache block."
        )

print("\n" + "=" * 80)
print("DIAGNOSTIC COMPLETE")
print("=" * 80)


