        return {
            "train": [],
            "val": [],
            "test": [],
        }

    try:
        with open(
            progress_path,
            "r"
        ) as f:
            progress = json.load(f)

        for key in ["train", "val", "test"]:
            if key not in progress:
                progress[key] = []

        return progress

    except Exception:
        print(
            "⚠️ Existing progress file could not be read. "
            "Rebuilding progress from actual cache files."
        )

        return {
            "train": [],
            "val": [],
            "test": [],
        }


progress = load_progress()


def update_progress(
    split_name,
    block_id
):
    block_id = int(block_id)

    if block_id not in progress[split_name]:
        progress[split_name].append(block_id)

    progress[split_name] = sorted(
        set(progress[split_name])
    )

    temporary_progress = (
        progress_path + ".tmp"
    )

    with open(
        temporary_progress,
        "w"
    ) as f:
        json.dump(
            progress,
            f,
            indent=2
        )

    os.replace(
        temporary_progress,
        progress_path
    )


# ------------------------------------------------
# 7. Verify existing cache files
# ------------------------------------------------

def block_filename(
    split_name,
    block_id
):
    return os.path.join(
        CACHE_ROOT,
        split_name,
        f"{split_name}_{block_id:04d}.npz"
    )


def verify_cache_file(
    path
):

    if not os.path.exists(path):
        return False

    try:

        with np.load(
            path,
            allow_pickle=False
        ) as data:

            if "time" not in data.files:
                return False

            if len(data["time"]) == 0:
                return False

            expected_vars = [
                str(x)
                for x in forecast_base.data_vars
            ]

            for variable in expected_vars:

                if variable not in data.files:
                    return False

                if data[variable].size == 0:
                    return False

        return True

    except Exception:
        return False


# Rebuild progress from actual valid cache files.
for split_name, blocks in [
    ("train", train_blocks),
    ("val", val_blocks),
    ("test", test_blocks),
]:

    valid_ids = []

    for block in blocks:

        path = block_filename(
            split_name,
            block["id"]
        )

        if verify_cache_file(path):
            valid_ids.append(
                block["id"]
            )

    progress[split_name] = sorted(
        set(valid_ids)
    )

