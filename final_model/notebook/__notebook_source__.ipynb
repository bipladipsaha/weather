print(
    "\n" + "=" * 80
)
print(
    "FINAL SMOKE TEST"
)
print(
    "=" * 80
)

smoke_x, smoke_y = next(
    iter(train_loader)
)

smoke_x = smoke_x.to(
    DEVICE,
    non_blocking=True
)

smoke_y = smoke_y.to(
    DEVICE,
    non_blocking=True
)

optimizer.zero_grad(
    set_to_none=True
)

if USE_AMP:

    with torch.autocast(
        device_type="cuda",
        dtype=torch.float16
    ):

        smoke_logits = model(
            smoke_x
        )

        smoke_loss = combined_loss(
            smoke_logits,
            smoke_y
        )

    scaler.scale(
        smoke_loss
    ).backward()

    scaler.unscale_(
        optimizer
    )

    torch.nn.utils.clip_grad_norm_(
        model.parameters(),
        1.0
    )

    scaler.step(
        optimizer
    )

    scaler.update()

else:

    smoke_logits = model(
        smoke_x
    )

    smoke_loss = combined_loss(
        smoke_logits,
        smoke_y
    )

    smoke_loss.backward()

    torch.nn.utils.clip_grad_norm_(
        model.parameters(),
        1.0
    )

    optimizer.step()

if not torch.isfinite(
    smoke_loss
):

    raise RuntimeError(
        "Final smoke-test loss is invalid."
    )

print(
    f"Input : {tuple(smoke_x.shape)}"
)

print(
