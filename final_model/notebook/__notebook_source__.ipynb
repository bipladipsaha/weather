def make_loader(
    dataset,
    batch_size,
    shuffle
):

    return DataLoader(
        dataset,
        batch_size=batch_size,
        shuffle=shuffle,
        num_workers=NUM_WORKERS,
        pin_memory=(
            DEVICE.type == "cuda"
        ),
        persistent_workers=(
            NUM_WORKERS > 0
        )
    )


candidate_batch_sizes = [
    8,
    4,
    2,
    1
]

selected_batch_size = None

print(
    "\n" + "=" * 80
)
print(
    "GPU MEMORY / MODEL SMOKE TEST"
)
print(
    "=" * 80
)

for candidate in candidate_batch_sizes:

    print(
        f"\nTrying batch size {candidate}..."
    )

    trial_model = STEANet(
        in_channels=CHANNELS,
        num_classes=NUM_CLASSES
    ).to(DEVICE)

    trial_optimizer = torch.optim.AdamW(
        trial_model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    trial_loader = make_loader(
        train_dataset,
        candidate,
        True
    )

    try:

        trial_x, trial_y = next(
            iter(trial_loader)
        )

        trial_x = trial_x.to(
            DEVICE,
            non_blocking=True
        )

        trial_y = trial_y.to(
            DEVICE,
            non_blocking=True
        )

        trial_optimizer.zero_grad(
            set_to_none=True
        )

        with torch.autocast(
            device_type=DEVICE.type,
            enabled=USE_AMP
        ):

            trial_logits = trial_model(
                trial_x
            )

            trial_loss = combined_loss(
                trial_logits,
                trial_y
            )

        if not torch.isfinite(
            trial_loss
        ):

            raise RuntimeError(
                "Trial loss is not finite."
            )

        trial_loss.backward()

        trial_optimizer.step()

        print(
            f"✅ Batch size {candidate} works"
        )

        print(
            f"   Input : "
            f"{tuple(trial_x.shape)}"
        )

        print(
            f"   Output: "
            f"{tuple(trial_logits.shape)}"
        )

        print(
            f"   Loss  : "
            f"{trial_loss.item():.6f}"
        )

        selected_batch_size = candidate

        del trial_x
        del trial_y
        del trial_logits
        del trial_loss

        break

    except RuntimeError as error:

        if (
            "out of memory"
            in str(error).lower()
        ):

            print(
                f"⚠️ Batch size {candidate} "
                f"caused CUDA OOM."
            )

            if DEVICE.type == "cuda":
                torch.cuda.empty_cache()

        else:

            raise

    finally:

        del trial_model
        del trial_optimizer
        del trial_loader

        gc.collect()

        if DEVICE.type == "cuda":
            torch.cuda.empty_cache()


if selected_batch_size is None:

    raise RuntimeError(
