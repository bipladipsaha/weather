# ================================================================
# 5. MODEL
# ================================================================

class ResidualBlock3D(
    nn.Module
):

    def __init__(
        self,
        channels
    ):

        super().__init__()

        self.conv1 = nn.Conv3d(
            channels,
            channels,
            kernel_size=3,
            padding=1,
            bias=False
        )

        self.norm1 = nn.GroupNorm(
            8,
            channels
        )

        self.conv2 = nn.Conv3d(
            channels,
            channels,
            kernel_size=3,
            padding=1,
            bias=False
        )

        self.norm2 = nn.GroupNorm(
            8,
            channels
        )

    def forward(
        self,
        x
    ):

        residual = x

        x = self.conv1(x)
        x = self.norm1(x)
        x = F.gelu(x)

        x = self.conv2(x)
        x = self.norm2(x)

        x = x + residual
        x = F.gelu(x)

        return x


class STEANet(
    nn.Module
):

    def __init__(
        self,
        in_channels=30,
        num_classes=4
    ):

        super().__init__()

        self.stem = nn.Sequential(

            nn.Conv3d(
                in_channels,
                48,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.GroupNorm(
                8,
                48
            ),

            nn.GELU()
        )

        self.block1 = ResidualBlock3D(
            48
        )

        self.block2 = ResidualBlock3D(
            48
        )

        self.context = nn.Sequential(

            nn.Conv3d(
                48,
                64,
                kernel_size=3,
                padding=2,
                dilation=2,
                bias=False
            ),

            nn.GroupNorm(
                8,
                64
            ),

            nn.GELU()
        )

        self.block3 = ResidualBlock3D(
            64
        )

        self.head = nn.Sequential(

            nn.Conv3d(
                64,
                32,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.GroupNorm(
                8,
                32
            ),

            nn.GELU(),

            nn.Conv3d(
                32,
                num_classes,
                kernel_size=1
            )
        )

    def forward(
        self,
        x
    ):

        x = self.stem(x)
        x = self.block1(x)
        x = self.block2(x)
        x = self.context(x)
        x = self.block3(x)

        return self.head(x)


# ================================================================
# 6. LOSS
# ================================================================

positive_weights = torch.tensor(
    metadata["positive_weights"],
    dtype=torch.float32,
    device=DEVICE
).view(
    1,
    NUM_CLASSES,
    1,
    1,
    1
)

bce_loss = nn.BCEWithLogitsLoss(
    pos_weight=positive_weights
)


def dice_loss(
    logits,
    targets
):

    probabilities = torch.sigmoid(
        logits
    )

    dims = (
        0,
        2,
        3,
        4
    )

    intersection = (
        probabilities
        *
        targets
    ).sum(
        dim=dims
    )

    denominator = (
        probabilities.sum(
            dim=dims
        )
        +
        targets.sum(
            dim=dims
        )
    )

    dice = (
        2.0 * intersection
        + 1.0
    ) / (
        denominator
        + 1.0
    )

    return (
        1.0 - dice
    ).mean()


def combined_loss(
    logits,
    targets
):

    return (
        0.7
        *
        bce_loss(
            logits,
            targets
        )
        +
        0.3
        *
        dice_loss(
            logits,
            targets
        )
    )


# ================================================================
# 7. METRICS
# ================================================================

def new_counters():

    return {
        "tp": np.zeros(
            NUM_CLASSES,
            dtype=np.float64
        ),
        "fp": np.zeros(
            NUM_CLASSES,
            dtype=np.float64
        ),
        "fn": np.zeros(
            NUM_CLASSES,
            dtype=np.float64
        )
    }


def update_counters(
    logits,
    targets,
    counters
):

    probabilities = torch.sigmoid(
        logits
    )

    predictions = (
        probabilities >= 0.5
    )

    target_bool = (
        targets >= 0.5
    )

    dims = (
        0,
        2,
        3,
        4
    )

    tp = (
        predictions
        &
        target_bool
    ).sum(
        dim=dims
    )

    fp = (
        predictions
        &
        ~target_bool
    ).sum(
        dim=dims
    )

    fn = (
        ~predictions
        &
        target_bool
    ).sum(
        dim=dims
    )

    counters["tp"] += (
        tp.detach()
        .cpu()
        .numpy()
    )

    counters["fp"] += (
        fp.detach()
        .cpu()
        .numpy()
    )

    counters["fn"] += (
        fn.detach()
        .cpu()
        .numpy()
    )


def calculate_f1(
    counters
):

    tp = counters["tp"]
    fp = counters["fp"]
    fn = counters["fn"]

    precision = (
        tp /
        np.maximum(
            tp + fp,
            1.0
        )
    )

    recall = (
        tp /
        np.maximum(
            tp + fn,
            1.0
        )
    )

    f1 = (
        2.0
        *
        precision
        *
        recall
        /
        np.maximum(
            precision + recall,
            1e-8
        )
    )

    return f1


