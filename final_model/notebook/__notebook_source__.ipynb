    )

    valid_files = 0

    for block_id in range(
        expected_block_count
    ):

        path = block_filename(
            split_name,
            block_id
        )

        if verify_cache_file(path):
            valid_files += 1

    print(
        f"{split_name.upper():5s}: "
        f"{valid_files}/{expected_block_count} "
        f"valid blocks"
    )

    if valid_files != expected_block_count:
        all_ok = False


# ------------------------------------------------
# 14. Final cache size
# ------------------------------------------------

total_cache_bytes = 0

for root, dirs, files in os.walk(
    CACHE_ROOT
