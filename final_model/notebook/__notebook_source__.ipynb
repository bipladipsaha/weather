)

del smoke_x
del smoke_y
del smoke_logits
del smoke_loss

if DEVICE.type == "cuda":
    torch.cuda.empty_cache()

gc.collect()


# ================================================================
# 14. RESET MODEL AFTER SMOKE TEST
# ================================================================

model = STEANet(
    in_channels=CHANNELS,
    num_classes=NUM_CLASSES
).to(DEVICE)

optimizer = torch.optim.AdamW(
    model.parameters(),
    lr=LEARNING_RATE,
    weight_decay=WEIGHT_DECAY
)

scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
    optimizer,
    mode="max",
    factor=0.5,
    patience=3,
    min_lr=1e-6
)

if USE_AMP:

    scaler = torch.amp.GradScaler(
        "cuda"
    )


# ================================================================
# 15. TRAINING LOOP
# ================================================================

best_val_f1 = -1.0
best_epoch = 0

epochs_without_improvement = 0

history = []

checkpoint_path = os.path.join(
    MODEL_ROOT,
    "stea_net_best.pth"
)

print(
    "\n" + "=" * 80
)
print(
    "STARTING FULL TRAINING"
)
print(
    "=" * 80
)

print(
    f"Maximum epochs : {MAX_EPOCHS}"
)

print(
    f"Early stopping : {EARLY_STOPPING_PATIENCE}"
)

print(
    f"Batch size     : {selected_batch_size}"
)


for epoch in range(
    1,
    MAX_EPOCHS + 1
):

    epoch_start = time.time()

    # ------------------------------------------------------------
    # TRAIN
    # ------------------------------------------------------------

    model.train()

    train_loss_sum = 0.0
    train_count = 0

    for batch_x, batch_y in train_loader:

        batch_x = batch_x.to(
            DEVICE,
            non_blocking=True
        )

        batch_y = batch_y.to(
            DEVICE,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        if USE_AMP:

            with torch.autocast(
                device_type="cuda",
                dtype=torch.float16
            ):

                logits = model(
                    batch_x
                )

                loss = combined_loss(
                    logits,
                    batch_y
                )

            if not torch.isfinite(
                loss
            ):

                raise RuntimeError(
                    f"Invalid loss at epoch "
                    f"{epoch}."
                )

            scaler.scale(
                loss
            ).backward()

            scaler.unscale_(
                optimizer
            )

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                1.0
            )

            scaler.step(
                optimizer
            )

            scaler.update()

        else:

            logits = model(
                batch_x
            )

            loss = combined_loss(
                logits,
                batch_y
            )

            if not torch.isfinite(
                loss
            ):

                raise RuntimeError(
                    f"Invalid loss at epoch "
                    f"{epoch}."
                )

            loss.backward()

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                1.0
            )

            optimizer.step()

        batch_size_actual = (
            batch_x.shape[0]
        )

        train_loss_sum += (
            loss.item()
            *
            batch_size_actual
        )

        train_count += (
            batch_size_actual
        )

    train_loss = (
        train_loss_sum
        /
        train_count
    )

    # ------------------------------------------------------------
    # VALIDATION
    # ------------------------------------------------------------

    model.eval()

    val_loss_sum = 0.0
    val_count = 0

    counters = new_counters()

    with torch.no_grad():

        for batch_x, batch_y in val_loader:

            batch_x = batch_x.to(
                DEVICE,
                non_blocking=True
            )

            batch_y = batch_y.to(
                DEVICE,
                non_blocking=True
            )

            if USE_AMP:

                with torch.autocast(
                    device_type="cuda",
                    dtype=torch.float16
                ):

                    logits = model(
                        batch_x
                    )

                    loss = combined_loss(
                        logits,
                        batch_y
                    )

            else:

                logits = model(
                    batch_x
                )

                loss = combined_loss(
                    logits,
                    batch_y
                )

            batch_size_actual = (
                batch_x.shape[0]
            )

            val_loss_sum += (
                loss.item()
                *
                batch_size_actual
            )

            val_count += (
                batch_size_actual
            )

            update_counters(
                logits,
                batch_y,
                counters
            )

    val_loss = (
        val_loss_sum
        /
        val_count
    )

    val_f1 = calculate_f1(
        counters
    )

    mean_val_f1 = float(
        val_f1.mean()
    )

    scheduler.step(
        mean_val_f1
    )

    # ------------------------------------------------------------
    # CHECKPOINT
    # ------------------------------------------------------------

    improved = (
        mean_val_f1
        >
        best_val_f1
        +
        1e-5
    )

    if improved:

        best_val_f1 = (
            mean_val_f1
        )

        best_epoch = epoch

        epochs_without_improvement = 0

        torch.save(
            {
                "epoch": epoch,

                "model_state_dict":
                    model.state_dict(),

                "optimizer_state_dict":
                    optimizer.state_dict(),

                "best_val_f1":
                    best_val_f1,

                "batch_size":
                    selected_batch_size,

                "channel_names":
                    metadata[
                        "channel_names"
                    ],

                "lead_hours":
                    metadata[
                        "lead_hours"
                    ],

                "event_names":
                    EVENT_NAMES,

                "input_shape":
                    metadata[
                        "input_shape"
                    ]
            },
            checkpoint_path
        )

    else:

        epochs_without_improvement += 1

    epoch_seconds = (
        time.time()
        -
        epoch_start
    )

    current_lr = (
        optimizer.param_groups[0]["lr"]
    )

    record = {

        "epoch":
            int(epoch),

        "train_loss":
            float(train_loss),

        "val_loss":
            float(val_loss),

        "heat_f1":
            float(val_f1[0]),

        "cold_f1":
            float(val_f1[1]),

        "rain_f1":
            float(val_f1[2]),

        "cyclone_f1":
            float(val_f1[3]),

        "mean_val_f1":
            mean_val_f1,

        "learning_rate":
            float(current_lr),

        "epoch_seconds":
            float(epoch_seconds)
    }

    history.append(
        record
    )

    with open(
        os.path.join(
            MODEL_ROOT,
            "training_history.json"
        ),
        "w"
    ) as f:

        json.dump(
            history,
            f,
            indent=2
        )

    marker = (
        " *BEST*"
        if improved
        else ""
    )

    print(
        f"Epoch {epoch:03d}/{MAX_EPOCHS} | "
        f"train={train_loss:.4f} | "
        f"val={val_loss:.4f} | "
        f"F1={mean_val_f1:.4f} | "
        f"H={val_f1[0]:.3f} | "
        f"C={val_f1[1]:.3f} | "
        f"R={val_f1[2]:.3f} | "
        f"CY={val_f1[3]:.3f} | "
        f"lr={current_lr:.2e} | "
        f"{epoch_seconds:.1f}s"
        f"{marker}"
    )

    # ------------------------------------------------------------
    # EARLY STOPPING
    # ------------------------------------------------------------

    if (
        epochs_without_improvement
        >=
        EARLY_STOPPING_PATIENCE
    ):

        print(
            "\n⏹ Early stopping triggered."
        )

        break


