    for filename in files:

        filepath = os.path.join(
            root,
            filename
        )

        try:
            total_cache_bytes += os.path.getsize(
                filepath
            )
        except OSError:
            pass

total_cache_gb = (
    total_cache_bytes
    / (1024 ** 3)
)


