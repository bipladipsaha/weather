# ================================================================

class WeatherMemmapDataset(Dataset):

    def __init__(
        self,
        x_path,
        y_path
    ):

        if not os.path.exists(x_path):
            raise FileNotFoundError(x_path)

        if not os.path.exists(y_path):
            raise FileNotFoundError(y_path)

        self.X = np.load(
            x_path,
            mmap_mode="r"
        )

        self.y = np.load(
            y_path,
            mmap_mode="r"
        )

        if (
            self.X.shape[0]
            !=
            self.y.shape[0]
        ):

            raise RuntimeError(
                "X and y sample counts differ."
            )

    def __len__(self):

        return self.X.shape[0]

    def __getitem__(
        self,
        index
    ):

        x = np.asarray(
            self.X[index],
            dtype=np.float32
        )

        y = np.asarray(
            self.y[index],
            dtype=np.float32
        )

        return (
            torch.from_numpy(
                np.ascontiguousarray(x)
            ),
            torch.from_numpy(
                np.ascontiguousarray(y)
            )
        )


