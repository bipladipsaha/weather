import numpy as np
import xarray as xr

# ============================================================
# SIH26078 - CORRECT CLIMATOLOGY MATCHING
# ============================================================

def get_climatology_for_times(clim_ds, times):
    """
    Match each forecast-valid timestamp to the corresponding
    climatology day-of-year and 6-hour slot.

    Leap day (Feb 29) is preserved because the climatology
    contains all 366 days.
    """

    time_da = xr.DataArray(
        np.asarray(times),
        dims="sample_time",
        name="sample_time"
    )

    day_of_year = time_da.dt.dayofyear
    hour = time_da.dt.hour

    selected = clim_ds.sel(
        dayofyear=day_of_year,
        hour=hour
    )

    return selected


# ============================================================
# SIH26078 - FIRST FORECAST SAMPLE
# ============================================================

# Selected regional forecast variables
hres_v1_region_surface = (
    hres_v1[SURFACE_VARS]
    .sel(
        latitude=slice(-5, 40),
        longitude=slice(60, 100)
    )
)

hres_v1_region_upper = (
    hres_v1[UPPER_VARS]
    .sel(level=PRESSURE_LEVELS)
    .sel(
        latitude=slice(-5, 40),
        longitude=slice(60, 100)
    )
)

# First forecast initialization only
sample_forecast_surface = hres_v1_region_surface.isel(time=0)
sample_forecast_upper = hres_v1_region_upper.isel(time=0)

sample_times = valid_time_v1.isel(time=0).values

print("Forecast surface:")
print(sample_forecast_surface)

print("\nForecast upper-air:")
print(sample_forecast_upper)


# ============================================================
# MATCH CLIMATOLOGY TO THE 21 FORECAST VALID TIMES
# ============================================================

sample_clim = get_climatology_for_times(
    clim_ds=clim_needed,
    times=sample_times
)

print(sample_clim)


# ============================================================
# SIH26078 - ALIGN FORECAST AND CLIMATOLOGY
# ============================================================

sample_forecast_surface_aligned = (
    sample_forecast_surface
    .rename({"prediction_timedelta": "sample_time"})
)

sample_forecast_upper_aligned = (
    sample_forecast_upper
    .rename({"prediction_timedelta": "sample_time"})
)

# Make sure the time dimension is identical
sample_forecast_surface_aligned = (
    sample_forecast_surface_aligned.assign_coords(
        sample_time=np.arange(21)
    )
)

sample_forecast_upper_aligned = (
    sample_forecast_upper_aligned.assign_coords(
        sample_time=np.arange(21)
    )
)

sample_clim_aligned = sample_clim.assign_coords(
    sample_time=np.arange(21)
)

# Calculate anomalies
anomaly_surface = (
    sample_forecast_surface_aligned
    - sample_clim_aligned[SURFACE_VARS]
)

anomaly_upper = (
    sample_forecast_upper_aligned
    - sample_clim_aligned[UPPER_VARS]
)

print("Surface anomaly:")
print(anomaly_surface)

print("\nUpper-air anomaly:")
print(anomaly_upper)


print("2m temperature anomaly:")
print(
    float(anomaly_surface["2m_temperature"].min().compute()),
    "to",
    float(anomaly_surface["2m_temperature"].max().compute())
)

print("\nMSLP anomaly:")
print(
    float(anomaly_surface["mean_sea_level_pressure"].min().compute()),
    "to",
    float(anomaly_surface["mean_sea_level_pressure"].max().compute())
)

print("\nPrecipitation anomaly:")
print(
    float(anomaly_surface["total_precipitation_6hr"].min().compute()),
    "to",
    float(anomaly_surface["total_precipitation_6hr"].max().compute())
)


print("HRES units:")
for v in SURFACE_VARS:
    print(v, "->", hres[v].attrs.get("units"))

print("\nClimatology units:")
for v in SURFACE_VARS:
    print(v, "->", climatology[v].attrs.get("units"))


print("Precipitation HRES attributes:")
print(hres["total_precipitation_6hr"].attrs)

print("\nPrecipitation climatology attributes:")
print(climatology["total_precipitation_6hr"].attrs)


# ============================================================
# SIH26078 - UNIT-CORRECT ANOMALIES
# ============================================================

# Surface anomaly copy
anomaly_surface_corrected = anomaly_surface.copy()

# Convert precipitation anomaly from meters -> mm
anomaly_surface_corrected["total_precipitation_6hr"] = (
    anomaly_surface_corrected["total_precipitation_6hr"] * 1000.0
)

# Convert MSLP anomaly from Pa -> hPa
anomaly_surface_corrected["mean_sea_level_pressure"] = (
    anomaly_surface_corrected["mean_sea_level_pressure"] / 100.0
)

# Upper-air anomaly copy
anomaly_upper_corrected = anomaly_upper.copy()

# Geopotential stays in m^2/s^2
# Temperature stays in K
# Wind stays in m/s
# Specific humidity stays in kg/kg

print("Corrected surface anomaly units:")
print("2m temperature      : K")
print("10m U/V wind         : m/s")
print("MSLP anomaly         : hPa")
print("6h precipitation     : mm")

print("\nPrecipitation anomaly range (mm/6h):")
print(
    float(
        anomaly_surface_corrected[
            "total_precipitation_6hr"
        ].min().compute()
    ),
    "to",
    float(
        anomaly_surface_corrected[
            "total_precipitation_6hr"
        ].max().compute()
    )
)

print("\nMSLP anomaly range (hPa):")
print(
    float(
        anomaly_surface_corrected[
            "mean_sea_level_pressure"
        ].min().compute()
    ),
    "to",
    float(
        anomaly_surface_corrected[
            "mean_sea_level_pressure"
        ].max().compute()
    )
)


# ============================================================
# SIH26078 - MODEL FEATURE GROUPS
# ============================================================

MODEL_SURFACE_FEATURES = [
    "2m_temperature",
    "10m_u_component_of_wind",
    "10m_v_component_of_wind",
    "mean_sea_level_pressure",
    "total_precipitation_6hr",
]

MODEL_UPPER_FEATURES = [
    "geopotential",
    "temperature",
    "u_component_of_wind",
    "v_component_of_wind",
    "specific_humidity",
]

surface_input = anomaly_surface_corrected[
    MODEL_SURFACE_FEATURES
]

upper_input = anomaly_upper_corrected[
    MODEL_UPPER_FEATURES
]

print("Surface model input:")
print(surface_input)

print("\nUpper-air model input:")
print(upper_input)


# ============================================================
# DERIVED WIND FEATURES
# ============================================================

wind_anomaly = np.sqrt(
    surface_input["10m_u_component_of_wind"] ** 2
    +
    surface_input["10m_v_component_of_wind"] ** 2
)

surface_input = surface_input.assign(
    wind_anomaly=wind_anomaly
)

print(surface_input)


upper_wind_speed = np.sqrt(
    upper_input["u_component_of_wind"] ** 2
    +
    upper_input["v_component_of_wind"] ** 2
)

upper_input = upper_input.assign(
    wind_speed_anomaly=upper_wind_speed
)

print(upper_input)


# ============================================================
# SIH26078 - TRAINING ANOMALY STATISTICS
# ============================================================

TRAIN_START = "2016-01-01"
TRAIN_END   = "2020-12-31 18:00:00"

# Select training-period ERA5
era5_train = (
    era5
    .sel(time=slice(TRAIN_START, TRAIN_END))
    .sel(
        latitude=slice(-5, 40),
        longitude=slice(60, 100)
    )
)

era5_train_surface = era5_train[SURFACE_VARS]

era5_train_upper = (
    era5_train[UPPER_VARS]
    .sel(level=PRESSURE_LEVELS)
)

print("ERA5 training period:")
print(era5_train.time.values[0], "→", era5_train.time.values[-1])

print("\nTraining surface:")
print(era5_train_surface)

print("\nTraining upper-air:")
print(era5_train_upper)


# ============================================================
# SIH26078 - REBUILD TRAINING CLIMATOLOGY
# ============================================================

import numpy as np
import xarray as xr

# Get the exact ERA5 training timestamps
train_times = era5_train_surface.time.values

# Match each timestamp to its corresponding
# day-of-year and hour in the ERA5 climatology
train_clim = get_climatology_for_times(
    climatology,
    train_times
)

# The helper function returns a "sample_time" dimension.
# Rename it back to "time" so it aligns with ERA5.
train_clim = train_clim.rename(
    {"sample_time": "time"}
)

# Explicitly use the ERA5 training timestamps
train_clim = train_clim.assign_coords(
    time=era5_train_surface.time
)

print("=" * 70)
print("TRAINING CLIMATOLOGY RESTORED")
print("=" * 70)

print("Dimensions:")
print(train_clim.dims)

print("\nSizes:")
print(train_clim.sizes)

print("\nTime range:")
print(
    str(train_clim.time.values[0]),
    "→",
    str(train_clim.time.values[-1])
)

print("\nTraining ERA5 time range:")
print(
    str(era5_train_surface.time.values[0]),
    "→",
    str(era5_train_surface.time.values[-1])
)

print("\nClimatology aligned with ERA5 training data.")


# ============================================================
# ERA5 CLIMATOLOGY-RELATIVE ANOMALIES
# ============================================================

era5_train_surface_anom = (
    era5_train_surface -
    train_clim[SURFACE_VARS]
)

era5_train_upper_anom = (
    era5_train_upper -
    train_clim[UPPER_VARS]
)

# Convert precipitation from m → mm/6h
era5_train_surface_anom["total_precipitation_6hr"] *= 1000.0

# Convert MSLP Pa → hPa
era5_train_surface_anom["mean_sea_level_pressure"] /= 100.0

print("ERA5 training anomalies prepared.")


# ============================================================
# MATCH ERA5 TRAINING DATA TO CLIMATOLOGY
# ============================================================

train_times = era5_train.time.values

train_clim = get_climatology_for_times(
    clim_ds=clim_needed,
    times=train_times
)

# Rename sample_time → time so it aligns with ERA5
train_clim = train_clim.rename(
    {"sample_time": "time"}
)

print(train_clim)


# ============================================================
# TRAINING STANDARD DEVIATIONS
# ============================================================

surface_std = era5_train_surface_anom.std(dim="time")

upper_std = era5_train_upper_anom.std(dim="time")

print("Surface standard deviations:")
print(surface_std)

print("\nUpper-air standard deviations:")
print(upper_std)


# ============================================================
# SIH26078 - STANDARDIZED ANOMALIES
# ============================================================

# Surface standardized anomalies
z_surface = xr.Dataset()

for var in MODEL_SURFACE_FEATURES:
    z_surface[var] = (
        anomaly_surface_corrected[var]
        / surface_std[var]
    )

# Upper-air standardized anomalies
z_upper = xr.Dataset()

for var in MODEL_UPPER_FEATURES:
    z_upper[var] = (
        anomaly_upper_corrected[var]
        / upper_std[var]
    )

# Avoid numerical problems from extremely small std values
z_surface = z_surface.fillna(0)
z_upper = z_upper.fillna(0)

print("Standardized surface anomalies:")
print(z_surface)

print("\nStandardized upper-air anomalies:")
print(z_upper)


import dask

# Compute both statistics together so Dask can share/parallelize work
surface_std_computed, upper_std_computed = dask.compute(
    surface_std,
